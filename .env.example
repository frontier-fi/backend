PORT=4000
NODE_ENV=staging
DEPLOYMENT_ENV=staging

# RPCs
DRPC_API_KEY=

# Database
DATABASE_URL=postgresql://backend:let-me-in@localhost:5431/database?schema=public

# Process role. Leave both false to run the API.
# Set both true to run the scheduler and worker in one process.
WORKER=false
SCHEDULER=false
WORKER_QUEUE_URL=http://localhost:4000

# SOR. Leave SOR_SERVICE_URL unset to quote swaps in this process.
# Set it to proxy quotes to a separate instance that runs with SOR_INSTANCE=true.
# SOR_SERVICE_URL=http://localhost:4001/graphql

# Reporting
SENTRY_DSN=https://123@oi456.ingest.sentry.io/123
APOLLO_SCHEMA_REPORTING=false
APOLLO_GRAPH_REF=<not-required-if-reporting-false>
APOLLO_API_KEY=<not-required-if-reporting-false>

# Admin routes
ADMIN_API_KEY=<chose-a-value>

# Production only, behind Stellate: requests without this secret are rejected. Leave unset locally.
# STELLATE_ORIGIN_SECRET=
# Production only: request metrics and the schema are sent to Stellate. Ignored unless NODE_ENV=production.
# STELLATE_LOGGING_TOKEN=
