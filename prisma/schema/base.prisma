// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Chain {
    BASE
    MAINNET
    SEPOLIA
}

model PrismaLastBlockSynced {
    @@id([category, chain])

    category            PrismaLastBlockSyncedCategory
    chain               Chain       @default(SEPOLIA)
    blockNumber         Int
}

enum PrismaLastBlockSyncedCategory {
    POOLS
    POOLS_V3
    ADD_POOLS_V3
    FARMS
    SNAPSHOTS_V2
    SNAPSHOTS_V3
    SNAPSHOTS
    BPT_BALANCES_V2
    BPT_BALANCES_V3
    BPT_BALANCES_FBEETS
    JOIN_EXITS_V2
    SWAPS_V2
    JOIN_EXITS_V3
    SWAPS_V3
}
