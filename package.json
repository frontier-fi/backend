{
    "name": "backend",
    "version": "2.1.24",
    "description": "Backend service for Frontier Finance",
    "repository": "https://github.com/frontier-fi/backend",
    "author": "maxyz.xyz",
    "license": "MIT",
    "private": true,
    "scripts": {
        "start": "node dist/apps/main.js",
        "dev": "bun --hot run apps/main.ts",
        "build": "tsc -p tsconfig.build.json",
        "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "bun run format:check && bun run test -- run && bun run build && bun run typecheck:tests",
        "generate": "bun scripts/generate.ts",
        "generate:api": "bun scripts/generate-api.ts",
        "sync-config": "bun scripts/sync-network-config.ts",
        "sor-backtest": "bun scripts/sor-backtest.ts",
        "test": "vitest",
        "test:e2e": "vitest run --config vitest.e2e.config.mts",
        "vitest": "vitest",
        "task": "bun run tasks/index.ts",
        "mutation": "sh scripts/run_mutation.sh",
        "sor-data": "bun run test/testData/index.ts false",
        "sor-data:overwrite": "bun run test/testData/index.ts true",
        "sor-data:debug": "bun run test/testData/index.ts true true"
    },
    "dependencies": {
        "@aave-dao/aave-address-book": "^4.74.6",
        "@apollo/server": "^5.5.1",
        "@as-integrations/express5": "^1.1.2",
        "@balancer-labs/balancer-maths": "^0.0.41",
        "@balancer/sdk": "^5.2.9",
        "@escape.tech/graphql-armor": "^3.2.0",
        "@prisma/client": "^6.19.3",
        "@types/graphql-fields": "^1.3.9",
        "abitype": "^1.3.0",
        "dotenv": "^18.0.8",
        "ethers": "^6.17.0",
        "express": "^5.3.0",
        "graphql": "^16.14.2",
        "graphql-fields": "^2.0.3",
        "graphql-request": "^3.7.0",
        "graphql-tag": "^2.12.7",
        "helmet": "^8.3.0",
        "jsonpath-plus": "^11.2.1",
        "limiter": "^4.1.0",
        "lodash": "^4.18.1",
        "memory-cache": "^0.2.0",
        "moment-timezone": "^0.6.5",
        "murmurhash": "^2.0.1",
        "prisma": "^6.19.3",
        "ts-dotenv": "^0.9.1",
        "viem": "^2.57.10"
    },
    "devDependencies": {
        "@faker-js/faker": "^8.4.1",
        "@graphql-codegen/add": "^3.2.3",
        "@graphql-codegen/cli": "^2.16.5",
        "@graphql-codegen/schema-ast": "^2.6.1",
        "@graphql-codegen/typescript": "2.4.0",
        "@graphql-codegen/typescript-graphql-request": "^4.5.9",
        "@graphql-codegen/typescript-operations": "^2.5.13",
        "@graphql-codegen/typescript-resolvers": "2.4.1",
        "@types/bun": "^1.4.3",
        "@types/express": "^5.0.6",
        "@types/lodash": "^4.17.27",
        "@types/memory-cache": "^0.2.6",
        "@types/node": "^24.19.2",
        "fishery": "^2.4.0",
        "graphql-codegen-typescript-mock-data": "^5.2.0",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vite": "^6.4.0",
        "vitest": "^5"
    },
    "overrides": {
        "graphql": "16.14.2",
        "ws": "^8.21.0"
    }
}
