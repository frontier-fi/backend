{
    "compilerOptions": {
        "esModuleInterop": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "lib": ["ES2022", "DOM"],
        "module": "commonjs",
        "strict": true,
        "target": "ES2022",
        "resolveJsonModule": true,
        "outDir": "./dist",
        "skipLibCheck": true,
        "sourceMap": true,
        "types": ["vitest/globals", "bun"]
    },
    "exclude": ["node_modules", "debug"]
}
